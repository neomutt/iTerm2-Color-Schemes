# SeedFlip Pulse – NeoMutt adaptation
#
# Generated automatically from iTerm2-Color-Schemes
# Source: SeedFlip Pulse
#
# Base palette
# bg:  #121212
# fg:  #ffffff
# grey:#454545

set color_directcolor = yes

########################################
# Global Defaults
########################################

color normal        #ffffff #121212
color error         #e34f4f #121212
color message       #4f8de3 #121212
color indicator     #121212 #eede91
color tree          #454545 #121212

########################################
# Status Bar
########################################

color status        #ffffff #454545

########################################
# Index View
########################################

color index         #ffffff #121212
color index_number  #454545 #121212
color index_author  #4f8de3 #121212
color index_subject #ffffff #121212
color index_date    #e3cb4f #121212
color index_flags   #ee9191 #121212

color index #e34f4f #121212 "~D"
color index #eede91 #121212 "~T"

########################################
# Headers
########################################

color hdrdefault    #ffffff #121212
color header #4f8de3 #121212 "^From:"
color header #4f8de3 #121212 "^To:"
color header #e3cb4f #121212 "^Subject:"
color header #e3cb4f #121212 "^Date:"
color header #91eeee #121212 "^Reply-To:"
color header #91eeee #121212 "^Message-ID:"

########################################
# Body
########################################

color body          #ffffff #121212 ".*"
color quoted0       #91eeb0 #121212
color quoted1       #91eeee #121212
color signature     #454545 #121212
color body #91b8ee #121212 "(https?|ftp)://[^ ]+"

########################################
# Search
########################################

color search #121212 #e3cb4f

########################################
# Compose
########################################

color compose_header #4f8de3 #121212
color compose_security_encrypt #ee9191 #121212
color compose_security_sign #91eeb0 #121212
color compose_security_both #91eeee #121212

########################################
# Diff / Patch
########################################

color body #121212 #91eeb0 "^\\+.*"
color body #121212 #e34f4f "^-.*"
color body #121212 #e3cb4f "^@@.*"

# vim: ft=neomuttrc
