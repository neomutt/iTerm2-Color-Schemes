# Cursor Dark – NeoMutt adaptation
#
# Generated automatically from iTerm2-Color-Schemes
# Source: Cursor Dark
#
# Base palette
# bg:  #141414
# fg:  #d4d4d4
# grey:#4a4a4a

set color_directcolor = yes

########################################
# Global Defaults
########################################

color normal        #d4d4d4 #141414
color error         #fc6b83 #141414
color message       #81a1c1 #141414
color indicator     #141414 #f1b467
color tree          #4a4a4a #141414

########################################
# Status Bar
########################################

color status        #d4d4d4 #4a4a4a

########################################
# Index View
########################################

color index         #d4d4d4 #141414
color index_number  #4a4a4a #141414
color index_author  #81a1c1 #141414
color index_subject #d4d4d4 #141414
color index_date    #d2943e #141414
color index_flags   #fc6b83 #141414

color index #fc6b83 #141414 "~D"
color index #f1b467 #141414 "~T"

########################################
# Headers
########################################

color hdrdefault    #d4d4d4 #141414
color header #81a1c1 #141414 "^From:"
color header #81a1c1 #141414 "^To:"
color header #d2943e #141414 "^Subject:"
color header #d2943e #141414 "^Date:"
color header #88c0d0 #141414 "^Reply-To:"
color header #88c0d0 #141414 "^Message-ID:"

########################################
# Body
########################################

color body          #d4d4d4 #141414 ".*"
color quoted0       #70b489 #141414
color quoted1       #88c0d0 #141414
color signature     #4a4a4a #141414
color body #87a6c4 #141414 "(https?|ftp)://[^ ]+"

########################################
# Search
########################################

color search #141414 #d2943e

########################################
# Compose
########################################

color compose_header #81a1c1 #141414
color compose_security_encrypt #fc6b83 #141414
color compose_security_sign #70b489 #141414
color compose_security_both #88c0d0 #141414

########################################
# Diff / Patch
########################################

color body #141414 #70b489 "^\\+.*"
color body #141414 #fc6b83 "^-.*"
color body #141414 #d2943e "^@@.*"

# vim: ft=neomuttrc
